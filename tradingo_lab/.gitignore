.venv/
__pycache__/
*.pyc

# Historical market data and generated reports are local artifacts.
data/ticks/**
data/rates/**
data/bars/**
data/reports/**
data/metadata/**
reports/**

# MQL5 generated artifacts.
*.ex5
mql5/compile_*.log

!.gitignore
!data/ticks/.gitkeep
!data/rates/.gitkeep
!data/bars/.gitkeep
!data/reports/.gitkeep
